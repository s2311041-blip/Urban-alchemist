# Supabase（クラウド同期・任意）
# 設定すると LAN なしで他端末と投稿を共有できます
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LLM 困り型分類は Supabase Edge Function の Secrets に設定（クライアントには不要）
# 手順: docs/33_AR_LLM分類設定.md

# LAN 同期（Supabase 未設定時・ワークショップ用）
# VITE_AR_API_URL=/ar-api

# ファシリ・研究用（JSON 書き出しボタンを AR 図鑑に表示）
# VITE_AR_FACILITATOR=true
